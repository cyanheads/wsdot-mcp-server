{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "wsdot-mcp-server",
  "version": "0.4.0",
  "description": "Query WA highway conditions, ferry schedules, vessel locations, toll rates, border waits, and alerts via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/wsdot-mcp-server#readme",
  "repository": "https://github.com/cyanheads/wsdot-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "wsdot", "traffic", "ferries", "washington"],
  "userConfig": {
    "WSDOT_ACCESS_CODE": {
      "type": "string",
      "title": "WSDOT access code",
      "description": "Required. WSDOT Traveler API access code. Register at wsdot.wa.gov/Traffic/api.",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "wsdot-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/wsdot-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "WSDOT_ACCESS_CODE": "${user_config.WSDOT_ACCESS_CODE}"
      }
    }
  }
}
